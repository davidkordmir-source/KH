{
  "name": "dideban-newsroom",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others -n api,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --env-file-if-exists=.env --watch server/index.mjs",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test": "node --test tests/*.test.mjs server/*.test.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/vazirmatn": "^5.3.0",
    "express": "^5.3.0",
    "fast-xml-parser": "^5.11.2",
    "lucide-react": "0.468.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "undici": "^8.12.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
